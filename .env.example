# Токен бота от @BotFather
BOT_TOKEN=

# ID пользователей Telegram через запятую, которым отвечает бот. Пусто - отвечает всем.
ALLOWED_USER_IDS=

# Модель по умолчанию в формате provider:model (provider - name из providers.yaml).
# Пусто - первая доступная модель.
DEFAULT_MODEL=gemini:gemini-3.8-flash

# Системный промпт (необязательно)
SYSTEM_PROMPT=Ты полезный ассистент. Отвечай кратко и по делу, удобно читаемо для интерфейса telegram-а

PROVIDERS_FILE=providers.yaml
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# API-ключи. Имена переменных задаются в providers.yaml (api_key_env).
# Провайдер с пустым ключом просто не подключается.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
